# ============================================================
# Data mode
# ============================================================
# REAL-DATA MODE: set VITE_API_BASE_URL to a browser-reachable address of the
# Foundation Flow FastAPI backend (see backend/ in the foundation-flow
# repository). The UI then serves API data only — if the backend is
# unreachable, pages show a connection error instead of sample numbers.
#
# DEMO MODE: leave VITE_API_BASE_URL unset. The UI renders clearly labeled
# illustrative sample data so the design can be explored without a backend.
VITE_API_BASE_URL=http://localhost:8000

# SSR only (Docker): server-side fetches run inside the frontend container,
# where `localhost` is the container itself. API_INTERNAL_URL points at the
# backend over the Docker network. Read at runtime, not baked into the build.
# API_INTERNAL_URL=http://backend:8000
