# Foundation Flow API configuration.
# Either set DATABASE_URL directly...
# DATABASE_URL=postgresql://airflow:change_me@localhost:5432/analytics

# ...or the individual variables (defaults match infrastructure/.env.example).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=analytics
POSTGRES_USER=airflow
POSTGRES_PASSWORD=replace_with_a_strong_postgres_password

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
