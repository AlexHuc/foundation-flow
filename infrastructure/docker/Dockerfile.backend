# Foundation Flow API — FastAPI + asyncpg, read-only over the PostgreSQL
# `landing` schema. Build context is the repository root:
#   docker build -f infrastructure/docker/Dockerfile.backend .
# (docker compose already sets this context for the `backend` service.)

FROM python:3.12-slim

WORKDIR /app

# Dependencies first for Docker layer caching.
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/app ./app

EXPOSE 8000

# Configuration arrives via environment variables (POSTGRES_HOST=postgres etc.,
# see infrastructure/.env.example). The API enforces read-only transactions at
# the session level; /api/health returns 503 until PostgreSQL answers.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
