# PostgreSQL
POSTGRES_USER=airflow
POSTGRES_PASSWORD=replace_with_a_strong_postgres_password
POSTGRES_DB=analytics
POSTGRES_PORT=5432

# TimescaleDB
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=replace_with_a_strong_timescale_password
TIMESCALE_DB=analytics_prod
TIMESCALE_PORT=5433

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=replace_with_a_strong_pgadmin_password
PGADMIN_PORT=5050

# Airflow metadata database connection
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:replace_with_a_strong_postgres_password@postgres:5432/analytics

# Airflow
AIRFLOW_HOME=/opt/airflow
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__AUTH_MANAGER=airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager
AIRFLOW__CORE__MIN_SERIALIZATION_INTERVAL=0
AIRFLOW__CORE__LOAD_DEFAULT_CONNECTIONS=False
AIRFLOW__DAG_PROCESSOR__REFRESH_INTERVAL=1
AIRFLOW__CORE__STORE_SERIALIZED_DAGS=False
AIRFLOW__CORE__LOAD_EXAMPLES=False
LOG_LEVEL=INFO
AIRFLOW_WEBSERVER_PORT=8080


#dbt
DBT_POSTGRES_HOST=postgres
DBT_TIMESCALE_HOST=timescale