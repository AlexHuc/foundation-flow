# Environment Configuration
# Copy this file to .env and update values as needed

# PostgreSQL Configuration
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=analytics
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# TimescaleDB Configuration
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=postgres
TIMESCALE_DB=analytics_prod
TIMESCALE_PORT=5433
TIMESCALE_HOST=timescale

# Airflow Configuration
AIRFLOW_HOME=/opt/airflow
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/analytics
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__LOAD_DEFAULT_CONNECTIONS=False
AIRFLOW__DAG_PROCESSOR__REFRESH_INTERVAL=1
AIRFLOW__CORE__STORE_SERIALIZED_DAGS=False
AIRFLOW__CORE__MIN_SERIALIZATION_INTERVAL=0

# FastAPI Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_ENV=development
FASTAPI_DEBUG=True

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TIMEOUT=30000

# Application Configuration
STOCKS_DEFAULT_TICKERS=AAPL,MSFT,GOOGL,AMZN,TSLA
LOG_LEVEL=INFO

# Yahoo Finance Configuration
YAHOO_FINANCE_TIMEOUT=30
YAHOO_FINANCE_MAX_RETRIES=3
